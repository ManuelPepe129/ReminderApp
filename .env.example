# Copy to .env and adjust. Never commit the real .env.

# --- API (npm run dev) ---
DATABASE_URL=postgres://reminder:reminder@localhost:5433/reminder
# Public URL of the web app (links in e-mails + CSRF Origin check).
# Dev (Vite): http://localhost:5173 — Docker full stack: http://localhost:8080
APP_ORIGIN=http://localhost:5173
PORT=3000
LOG_LEVEL=info
# Cookies get the Secure flag automatically when APP_ORIGIN is https.
# COOKIE_SECURE=true
# Behind a reverse proxy (nginx, load balancer):
# TRUST_PROXY=true

# --- E-mail (Mailpit in dev: UI at http://localhost:8025) ---
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Promemoria <noreply@localhost>

# --- Web Push (generate with: npm run vapid:generate -w @reminder/api) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Worker ---
WORKER_INTERVAL_SECONDS=60

# --- Rate limits ---
INVITE_RATE_LIMIT_PER_HOUR=20
AUTH_RATE_LIMIT_PER_15MIN=20

# --- Docker Compose overrides ---
# POSTGRES_PASSWORD=reminder
# POSTGRES_PORT=5433
# WEB_PORT=8080
