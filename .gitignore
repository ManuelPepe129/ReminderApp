# Database dumps & local data
# (migrations in apps/api/drizzle/*.sql ARE versioned)
# ---------------------------------------------------------------
backups/
*.dump
*.sql.gz
/backup*.sql
pgdata/

# ---------------------------------------------------------------
# Logs
# ---------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

